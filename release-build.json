{
  "appId": "com.manju.doubao.creativehub.public",
  "productName": "豆包创作舱（公开版）",
  "directories": {
    "output": "release"
  },
  "files": [
    "src/**/*",
    "package.json",
    "!src/canvas/**",
    "!src/**/workspace.json",
    "!src/**/config.json",
    "!src/**/download-settings.json",
    "!src/**/voice-bindings.json",
    "!src/**/Cookies",
    "!src/**/User Data/**",
    "!src/**/*.sqlite",
    "!src/**/*.sqlite3",
    "!src/**/*.db",
    "!src/**/.env*",
    "!src/**/*.local.json",
    "!**/*.map",
    "!**/*.pdb"
  ],
  "asar": true,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "Doubao-Creative-Hub-Public-Setup-v${version}-x64.${ext}",
    "icon": "assets/app.ico"
  },
  "compression": "maximum",
  "electronFuses": {
    "runAsNode": false,
    "enableNodeOptionsEnvironmentVariable": false,
    "enableNodeCliInspectArguments": false,
    "enableEmbeddedAsarIntegrityValidation": true,
    "onlyLoadAppFromAsar": true
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "deleteAppDataOnUninstall": false
  },
  "extraResources": [
    {
      "from": "vendor/bin",
      "to": "bin",
      "filter": [
        "ffmpeg.exe",
        "ffprobe.exe",
        "COPYING.LGPLv2.1",
        "FFMPEG_NOTICE.txt"
      ]
    }
  ]
}
